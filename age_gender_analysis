def overall_demo_statistics(df_demo):
    stats_overall = pd.DataFrame({
        "count": [df_demo['age'].count()],
        "age_mean": [df_demo['age'].mean()],
        "age_std": [df_demo['age'].std()],
        "age_min": [df_demo['age'].min()],
        "age_25pct": [np.percentile(df_demo['age'], 25)],
        "age_50pct": [df_demo['age'].median()],
        "age_75pct": [np.percentile(df_demo['age'], 75)],
        "age_max": [df_demo['age'].max()],
        "bmi_mean": [df_demo['bmi'].mean()],
        "bmi_std": [df_demo['bmi'].std()],
        "bmi_min": [df_demo['bmi'].min()],
        "bmi_25pct": [np.percentile(df_demo['bmi'], 25)],
        "bmi_50pct": [df_demo['bmi'].median()],
        "bmi_75pct": [np.percentile(df_demo['bmi'], 75)],
        "bmi_max": [df_demo['bmi'].max()]
    })
    return stats_overall
